{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/downloads/Scorr-Setup.exe",
      "destination": "https://github.com/usmanHassanzai/HR/releases/download/desktop-v1.3.7/Scorr-Setup.exe",
      "permanent": false
    },
    {
      "source": "/downloads/Scorr.deb",
      "destination": "https://github.com/usmanHassanzai/HR/releases/download/desktop-v1.3.7/Scorr.deb",
      "permanent": false
    },
    {
      "source": "/downloads/Scorr.AppImage",
      "destination": "https://github.com/usmanHassanzai/HR/releases/download/desktop-v1.3.7/Scorr.AppImage",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|downloads/|icons/|fonts/|robots\\.txt$|sitemap\\.xml$|sw\\.js$|manifest\\.webmanifest$|.*\\.[A-Za-z0-9]{1,8}$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/version.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/build-meta.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/downloads/desktop/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    },
    {
      "source": "/downloads/build-info.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    },
    {
      "source": "/downloads/scorr.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"scorr.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/downloads/scorr.ipa",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/downloads/Scorr-Windows.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Scorr-Windows.zip\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/downloads/Scorr.AppImage",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Scorr.AppImage\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/downloads/Scorr.deb",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.debian.binary-package" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Scorr.deb\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(woff2?|ttf|otf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpe?g|gif|svg|ico|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
